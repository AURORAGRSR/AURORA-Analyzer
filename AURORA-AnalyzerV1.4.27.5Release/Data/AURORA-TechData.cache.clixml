            <Obj RefId="549">
              <TNRef RefId="2" />
              <MS>
                <S N="RuleId">C-012</S>
                <S N="NameCHS">网络重置</S>
                <S N="NameENG">Network Reset</S>
                <Obj N="EventIds" RefId="550">
                  <TNRef RefId="2" />
                </Obj>
                <Ref N="Sources" RefId="550" />
                <Nil N="RegexPatterns" />
                <Obj N="Commands" RefId="551">
                  <TNRef RefId="1" />
                  <LST>
                    <Obj RefId="552">
                      <TNRef RefId="2" />
                      <MS>
                        <S N="name">查看hosts文件内容</S>
                        <S N="name_en">View Hosts File Content</S>
                        <S N="command">Get-Content -Path "$env:SystemRoot\System32\drivers\etc\hosts"</S>
                        <S N="type">powershell</S>
                        <B N="elevation_required">true</B>
                        <S N="risk_level">Low</S>
                        <B N="auto_execute">false</B>
                        <S N="pre_check">$true</S>
                        <S N="rollback_command"></S>
                      </MS>
                    </Obj>
                    <Obj RefId="553">
                      <TNRef RefId="2" />
                      <MS>
                        <S N="name">重置hosts文件为默认</S>
                        <S N="name_en">Reset Hosts File to Default</S>
                        <S N="command"># 备份原文件; Copy-Item -Path "$env:SystemRoot\System32\drivers\etc\hosts" -Destination "$env:SystemRoot\System32\drivers\etc\hosts.backup"; # 写入默认内容; @('# Copyright (c) 1993-2009 Microsoft Corp.', '#', '# This is a sample HOSTS file used by Microsoft TCP/IP for Windows.', '#', '# This file contains the mappings of IP addresses to host names. Each', '# entry should be kept on an individual line. The IP address should', '# be placed in the first column followed by the corresponding host name.', '# The IP address and the host name should be separated by at least one', '# space.', '#', '# Additionally, comments (such as these) may be inserted on individual', '# lines or following the machine name denoted by a ''#'' symbol.', '#', '# For example:', '#', '#      102.54.94.97     rhino.acme.com          # source server', '#       38.25.63.10     x.acme.com              # x client host', '', '# localhost name resolution is handled within DNS itself.', '#_x0009_127.0.0.1       localhost', '#_x0009_::1             localhost') | Set-Content -Path "$env:SystemRoot\System32\drivers\etc\hosts" -Encoding ASCII</S>
                        <S N="type">powershell</S>
                        <B N="elevation_required">true</B>
                        <S N="risk_level">Medium</S>
                        <B N="auto_execute">false</B>
                        <S N="pre_check">$true</S>
                        <S N="rollback_command"># Please manually rollback according to specific operation</S>
                      </MS>
                    </Obj>
                    <Obj RefId="554">
                      <TNRef RefId="2" />
                      <MS>
                        <S N="name">重置Winsock目录</S>
                        <S N="name_en">Reset Winsock Catalog</S>
                        <S N="command">netsh winsock reset</S>
                        <S N="type">cmd</S>
                        <B N="elevation_required">true</B>
                        <S N="note">需要重启电脑</S>
                        <S N="risk_level">Medium</S>
                        <B N="auto_execute">false</B>
                        <S N="pre_check">$true</S>
                        <S N="rollback_command"># Please manually rollback according to specific operation</S>
                      </MS>
                    </Obj>
                    <Obj RefId="555">
                      <TNRef RefId="2" />
                      <MS>
                        <S N="name">重置TCP/IP堆栈</S>
                        <S N="name_en">Reset TCP/IP Stack</S>
                        <S N="command">netsh int ip reset</S>
                        <S N="type">cmd</S>
