                      <MS>
                        <S N="name">重置网络适配器</S>
                        <S N="name_en">Reset Network Adapters</S>
                        <S N="command">Get-NetAdapter | Disable-NetAdapter -Confirm:$false; Start-Sleep -Seconds 2; Get-NetAdapter | Enable-NetAdapter -Confirm:$false</S>
